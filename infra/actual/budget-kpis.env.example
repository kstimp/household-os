# Secrets for the budget-kpis service (hub landing page budget KPIs).
# Copy to budget-kpis.env (gitignored) on the VPS and fill in.
# See docs/runbook-landing-updates.md §4.
#
#   cp budget-kpis.env.example budget-kpis.env   # then edit budget-kpis.env

# Same value as API_KEY in actual-http-api.env.
ACTUAL_API_KEY=

# Budget Sync ID (Actual → Settings → Show advanced settings → Sync ID).
ACTUAL_BUDGET_SYNC_ID=

# ONLY if you enabled Actual end-to-end encryption. Leave blank otherwise.
ACTUAL_BUDGET_ENCRYPTION_PASSWORD=
