# Replace budget.example.com with your real host (matches Terraform's budget_host).
#
# We serve the Cloudflare Origin certificate and reverse-proxy to Actual.
# We deliberately DO NOT set Cross-Origin-Opener-Policy / Cross-Origin-Embedder-Policy
# here — Actual sets those itself, and adding them again would DUPLICATE the headers,
# which browsers reject with a fatal `SharedArrayBufferMissing` error. Let Actual own them.

money.example.com {
	tls /certs/origin.pem /certs/origin.key

	reverse_proxy actual-server:5006
}

# AI-facing MCP budget server (ADR-0002). Replace mcp-budget.example.com with your
# real host (matches Terraform's mcp_host output). This is a plain JSON/HTTP MCP
# endpoint — no SharedArrayBuffer, so none of the COOP/COEP concerns above apply.
# There is deliberately NO Cloudflare Access app on this host: the MCP server's own
# Bearer/OIDC token is the gate (Access would block the non-browser MCP client).
mcp-budget.example.com {
	tls /certs/mcp-origin.pem /certs/mcp-origin.key

	reverse_proxy actual-mcp:3600
}
