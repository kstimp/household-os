# Replace budget.example.com with your real host (matches Terraform's budget_host).
#
# We serve the Cloudflare Origin certificate and reverse-proxy to Actual.
# We deliberately DO NOT set Cross-Origin-Opener-Policy / Cross-Origin-Embedder-Policy
# here — Actual sets those itself, and adding them again would DUPLICATE the headers,
# which browsers reject with a fatal `SharedArrayBufferMissing` error. Let Actual own them.

money.example.com {
	tls /certs/origin.pem /certs/origin.key

	reverse_proxy actual-server:5006
}

# AI-facing MCP budget server (ADR-0002). Replace mcp-budget.example.com with your
# real host (matches Terraform's mcp_host output). This is a plain JSON/HTTP MCP
# endpoint — no SharedArrayBuffer, so none of the COOP/COEP concerns above apply.
# By default there is NO interactive Cloudflare Access app on this host: the MCP
# server's own Bearer/OIDC token is the gate (an interactive Access app would block
# the non-browser MCP client). An OPTIONAL non-interactive service-token Access layer
# can sit in front at the Cloudflare edge (ADR-0003, var.enable_mcp_access_service_token);
# it is transparent to Caddy — the client just adds CF-Access-Client-Id/Secret headers.
mcp-budget.example.com {
	tls /certs/mcp-origin.pem /certs/mcp-origin.key

	reverse_proxy actual-mcp:3600
}

college.example.com {
	tls /certs/college-origin.pem /certs/college-origin.key

	reverse_proxy college-app:3000
}

# Actual HTTP REST API (jhonderson/actual-http-api). Replace actual-api.example.com
# with your real host (matches Terraform's actual_api_host output).
# Like the MCP host, deliberately NO Cloudflare Access app here — programmatic
# REST clients can't do browser SSO. The gate is API_KEY in actual-http-api.env.
# See docs/install-actual-http-api.md.
actual-api.example.com {
	tls /certs/actual-api-origin.pem /certs/actual-api-origin.key

	reverse_proxy actual-http-api:5007
}
