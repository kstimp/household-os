# Secrets for the actual-http-api service (jhonderson/actual-http-api).
# Copy to actual-http-api.env (gitignored) on the VPS and fill in.
# See docs/install-actual-http-api.md.
#
#   cp actual-http-api.env.example actual-http-api.env   # then edit actual-http-api.env

# --- Auth gate (THE gate — this host has no Cloudflare Access) ---------------
# All API calls must include this as the X-Api-Key request header.
# Generate a strong one:  openssl rand -hex 32
API_KEY=

# --- Actual connection (from your Actual first-time setup) -------------------
# Server password you set in Actual (install-actual.md §10a).
ACTUAL_SERVER_PASSWORD=

# Budget Sync ID (Actual → Settings → Show advanced settings → Sync ID; §10e).
ACTUAL_BUDGET_SYNC_ID=

# ONLY if you enabled Actual end-to-end encryption (§10c). Leave blank otherwise.
# This hands the third-party container your E2E key — same risk as the MCP server.
ACTUAL_BUDGET_ENCRYPTION_PASSWORD=
