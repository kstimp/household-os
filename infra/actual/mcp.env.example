# Secrets for the actual-mcp service (agigante80/actual-mcp-server). Pinned image
# tag: v0.7.9 (see infra/actual/docker-compose.yml). Copy to mcp.env (gitignored)
# on the VPS and fill in. See docs/mcp-budget-server.md and ADR-0003.
#
#   cp mcp.env.example mcp.env   # then edit mcp.env

# --- Actual connection (from your Actual first-time setup) ------------------
# Server password you set in Actual (install-actual.md §10a).
ACTUAL_PASSWORD=

# Budget Sync ID (Actual → Settings → Show advanced settings → Sync ID; §10e).
ACTUAL_BUDGET_SYNC_ID=

# ONLY if you enabled Actual end-to-end encryption (§10c). Leave blank otherwise.
# This hands the third-party MCP process your E2E key — see the ADR threat model.
ACTUAL_BUDGET_PASSWORD=

# --- MCP server auth — pick ONE provider (this host has no browser SSO) ------
# This host is the AI-facing MCP endpoint; Cloudflare Access cannot front it
# (it would bounce the non-browser MCP client), so the gate is the server's own
# auth. AUTH_PROVIDER selects it. The two end-states are MUTUALLY EXCLUSIVE:
#
#   none → static shared Bearer token   (ADR-0002 v1 gate; now legacy/fallback)
#   oidc → per-user JWT, JWKS-validated  (ADR-0003 target — per-user identity + ACL)
#
# During the ADR-0003 cutover keep BOTH the Bearer token and the OIDC block set
# (defense in depth while validating). REMOVE the unused one only after OIDC is
# verified end-to-end — see the cutover sequence in docs/mcp-budget-server.md.

# --- (legacy / fallback) Static Bearer token --------------------------------
# Used when AUTH_PROVIDER is unset/none. Clients send `Authorization: Bearer <token>`.
# Generate a strong one:  openssl rand -hex 32
MCP_SSE_AUTHORIZATION=

# --- (target) Per-user OIDC / JWT — ADR-0003 --------------------------------
# Var names confirmed against agigante80/actual-mcp-server v0.7.9
# (docs/guides/AI_CLIENT_SETUP.md). The server fetches the issuer's JWKS and
# validates the token's SIGNATURE + ISSUER + AUDIENCE on every request — not just
# "a bearer string is present." Uncomment and set AUTH_PROVIDER=oidc to switch.
#
# AUTH_PROVIDER=oidc
#
# Issuer that mints the JWT. For the chosen Cloudflare-Access-as-issuer path this
# is your Zero Trust team domain; its JWKS is at <issuer>/cdn-cgi/access/certs.
# OIDC_ISSUER=https://<your-team>.cloudflareaccess.com
#
# Expected `aud` claim — must equal the audience the issuer stamps (for Cloudflare
# Access this is the Access application's Application Audience (AUD) tag).
# OIDC_RESOURCE=<expected-jwt-aud>
#
# Comma-separated required scopes. Leave EMPTY for issuers (Casdoor, Cloudflare
# Access) whose tokens carry no `scope` claim — a non-empty value would reject them.
# OIDC_SCOPES=
#
# Per-user budget ACL as a JSON object: principal → list of budget sync IDs.
# Principal key is an email claim, a `sub`, or "group:<name>" (matches groups/roles
# array entries). ["*"] grants all budgets; specific sync IDs scope to those budgets.
# AUTH_BUDGET_ACL={"you@gmail.com":["<budget-sync-id>"]}

# --- (optional) Cloudflare Access service-token layer — ADR-0003 interim -----
# A defense-in-depth header gate that is INDEPENDENT of AUTH_PROVIDER above (it
# lives at the Cloudflare edge, not in this container). If you enable the Access
# app + service token in infra/terraform/ (var.enable_mcp_access_service_token),
# the MCP client must additionally send these two headers; nothing is configured
# here — they are attached by the client. See docs/mcp-budget-server.md.
#   CF-Access-Client-Id:     <service-token client id>
#   CF-Access-Client-Secret: <service-token client secret>
