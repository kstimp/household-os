# Secrets for the actual-mcp service (agigante80/actual-mcp-server).
# Copy to mcp.env (gitignored) on the VPS and fill in. See docs/mcp-budget-server.md.
#
#   cp mcp.env.example mcp.env   # then edit mcp.env

# --- Actual connection (from your Actual first-time setup) ------------------
# Server password you set in Actual (install-actual.md §10a).
ACTUAL_PASSWORD=

# Budget Sync ID (Actual → Settings → Show advanced settings → Sync ID; §10e).
ACTUAL_BUDGET_SYNC_ID=

# ONLY if you enabled Actual end-to-end encryption (§10c). Leave blank otherwise.
# This hands the third-party MCP process your E2E key — see the ADR threat model.
ACTUAL_BUDGET_PASSWORD=

# --- MCP server auth (THE gate — this host has no Cloudflare Access) ---------
# Static Bearer token clients must send as `Authorization: Bearer <token>`.
# Generate a strong one:  openssl rand -hex 32
MCP_SSE_AUTHORIZATION=

# --- Optional OIDC upgrade (replaces the static Bearer token) ----------------
# To move from a shared token to per-user JWTs, set AUTH_PROVIDER=oidc and the
# OIDC_* vars (see eval doc "Hardening"), then remove MCP_SSE_AUTHORIZATION.
# AUTH_PROVIDER=oidc
# OIDC_ISSUER=
# OIDC_RESOURCE=
# AUTH_BUDGET_ACL=
