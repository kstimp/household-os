# Secrets for the actual-mcp service (agigante80/actual-mcp-server). Pinned image
# tag: 0.22.31 (see infra/actual/docker-compose.yml). Copy to mcp.env (gitignored)
# on the VPS and fill in. See docs/mcp-budget-server.md and ADR-0005 (the decision:
# CF Access SaaS-OIDC; Google-direct/ADR-0004 kept only as rollback). Use OPTION A;
# the two issuer blocks below are mutually exclusive.
#
#   cp mcp.env.example mcp.env   # then edit mcp.env

# --- Actual connection (from your Actual first-time setup) ------------------
# Server password you set in Actual (install-actual.md §10a).
ACTUAL_PASSWORD=

# Budget Sync ID (Actual → Settings → Show advanced settings → Sync ID; §10e).
ACTUAL_BUDGET_SYNC_ID=

# ONLY if you enabled Actual end-to-end encryption (§10c). Leave blank otherwise.
# This hands the third-party MCP process your E2E key — see the ADR threat model.
ACTUAL_BUDGET_PASSWORD=

# --- MCP server auth — Bearer token (legacy / interim) ----------------------
# Used when AUTH_PROVIDER is unset or absent. Clients send `Authorization: Bearer <token>`.
# Keep set during the ADR-0005 OIDC cutover; remove once OIDC is verified end-to-end.
# Generate a strong one:  openssl rand -hex 32
MCP_SSE_AUTHORIZATION=

# --- MCP server auth — Per-user OIDC / JWT --------------------------------------
# Setting AUTH_PROVIDER=oidc is a HARD FLIP that disables Bearer entirely — there is
# no dual-auth mode. Do not set it until you are ready to require OAuth for all clients.
# Use OPTION A (CF Access SaaS-OIDC — ADR-0005, the decision). OPTION B (Google-direct)
# is the rollback contingency only. AUTH_BUDGET_ACL applies to both.

# --- OPTION A: Cloudflare Access SaaS-OIDC (ADR-0005 — the decision) ------------
# CF Access acts as the OIDC IdP via a SaaS application (NOT a self-hosted app — that
# was the ADR-0003 mistake). The family allowlist stays in the CF Access policy, so it
# is NOT duplicated here; JWKS is same-origin (no OIDC_JWKS_TRUSTED_HOSTS). Configure
# access/refresh token lifetimes on the SaaS app to control re-auth frequency.
# Prerequisite: create the CF Access SaaS (OIDC) app + policy (docs/mcp-budget-server.md §7).
#
# Verified live on 0.22.11 with the Claude.ai connector. What CF SaaS tokens look like,
# and why each value below is what it is:
#   - `iss` is PER-APP (team domain + /cdn-cgi/access/sso/oidc/<client-id>), not the bare
#     team domain. Copy `issuer` from <issuer>/.well-known/openid-configuration, or
#     `terraform output -raw mcp_saas_oidc_issuer`.
#   - `aud` is the CLIENT'S REDIRECT URI (not the client ID, not OIDC_RESOURCE). Add one
#     entry per AI client, matching var.mcp_oauth_redirect_uris.
#   - The access token is a JWT (validatable via the same-origin JWKS) with NO `scope`
#     claim, so OIDC_SCOPES MUST be empty — any required scope rejects every token.
# AUTH_PROVIDER=oidc
# OIDC_ISSUER=https://<team>.cloudflareaccess.com/cdn-cgi/access/sso/oidc/<cf-saas-oidc-client-id>
# OIDC_RESOURCE=https://<mcp_host>/http             # this server's public MCP URL (RFC 9728 resource; endpoint form, no trailing slash)
# OIDC_ACCEPTED_AUDIENCES=https://claude.ai/api/mcp/auth_callback,<cf-saas-oidc-client-id>   # comma-separated; redirect URI(s) are the real `aud`
# OIDC_SCOPES=                                      # MUST be empty (CF access tokens carry no scope claim)
# OIDC_SCOPES_SUPPORTED=openid,email                # advertised to clients (comma-separated), not enforced
# (do NOT set OIDC_JWKS_TRUSTED_HOSTS — CF's JWKS is same-origin as the issuer)

# --- OPTION B: Google-direct OIDC (rollback contingency only — ADR-0004) -------
# Google is the issuer. The family allowlist must be replicated in AUTH_BUDGET_ACL
# (no CF-policy gate on this path). JWKS is cross-origin, so OIDC_JWKS_TRUSTED_HOSTS
# is REQUIRED. Publish the Google OAuth app to "In production" so refresh tokens do
# not expire (Testing = 7-day expiry → recurring re-auth prompts).
# Prerequisite: create a Google Cloud Console OAuth 2.0 Web Application client and
# register redirect URIs for each AI client before enabling (docs/mcp-budget-server.md §7).
#
# Not re-verified on 0.22.x. OIDC_RESOURCE / OIDC_SCOPES follow the upstream 0.22.x
# rules (endpoint-URL resource; comma-separated scopes) — check the token's `scope`
# claim before requiring any scope, or leave OIDC_SCOPES empty.
# AUTH_PROVIDER=oidc
# OIDC_ISSUER=https://accounts.google.com             # JWKS at https://www.googleapis.com/oauth2/v3/certs
# OIDC_RESOURCE=https://<mcp_host>/http               # this server's public MCP URL (endpoint form)
# OIDC_ACCEPTED_AUDIENCES=<google-oauth-client-id>    # bare client ID — must match `aud` in Google ID tokens
# OIDC_SCOPES=                                        # only list scopes the token's `scope` claim really carries
# OIDC_SCOPES_SUPPORTED=openid,email
# OIDC_JWKS_TRUSTED_HOSTS=www.googleapis.com          # REQUIRED for Google (issuer/JWKS cross-origin); opt-in, empty by default

# --- Shared: per-user budget ACL (both options) -------------------------------
# Maps a token principal to budget sync IDs. A key matches the token's `email` claim, or
# its `sub` (on CF, the user's Access `user_id` from Zero Trust → Logs → Access). Under
# OPTION A this is PER-BUDGET scoping only (the family gate is the CF Access policy);
# under OPTION B it is ALSO the family allowlist. `["*"]` grants all budgets.
# AUTH_BUDGET_ACL={"you@gmail.com":["*"],"spouse@gmail.com":["*"]}
