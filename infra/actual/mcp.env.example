# Secrets for the actual-mcp service (agigante80/actual-mcp-server). Pinned image
# tag: v0.7.11 (see infra/actual/docker-compose.yml). Copy to mcp.env (gitignored)
# on the VPS and fill in. See docs/mcp-budget-server.md and ADR-0004.
#
#   cp mcp.env.example mcp.env   # then edit mcp.env

# --- Actual connection (from your Actual first-time setup) ------------------
# Server password you set in Actual (install-actual.md §10a).
ACTUAL_PASSWORD=

# Budget Sync ID (Actual → Settings → Show advanced settings → Sync ID; §10e).
ACTUAL_BUDGET_SYNC_ID=

# ONLY if you enabled Actual end-to-end encryption (§10c). Leave blank otherwise.
# This hands the third-party MCP process your E2E key — see the ADR threat model.
ACTUAL_BUDGET_PASSWORD=

# --- MCP server auth — Bearer token (legacy / interim) ----------------------
# Used when AUTH_PROVIDER is unset or absent. Clients send `Authorization: Bearer <token>`.
# Keep set during the ADR-0004 OIDC cutover; remove once OIDC is verified end-to-end.
# Generate a strong one:  openssl rand -hex 32
MCP_SSE_AUTHORIZATION=

# --- MCP server auth — Per-user OIDC / JWT (ADR-0004 target) ----------------
# Google is the OIDC issuer (CF Access is not viable — see ADR-0003).
# Setting AUTH_PROVIDER=oidc is a HARD FLIP that disables Bearer entirely — there is
# no dual-auth mode. Do not set it until you are ready to require OAuth for all clients.
#
# Prerequisite: create a Google Cloud Console OAuth 2.0 Web Application client and
# register redirect URIs for each AI client before enabling (see docs/mcp-budget-server.md §7).
#
# AUTH_PROVIDER=oidc
#
# Google OIDC issuer. JWKS at https://www.googleapis.com/oauth2/v3/certs.
# OIDC_ISSUER=https://accounts.google.com
#
# Google OAuth client ID. In Google ID tokens, the `aud` claim equals the client ID.
# OIDC_RESOURCE=<google-oauth-client-id>
#
# Repeat the client ID here (OIDC_RESOURCE + OIDC_ACCEPTED_AUDIENCES together form the
# accepted audience set; setting both ensures the server accepts the aud claim format
# Google uses).
# OIDC_ACCEPTED_AUDIENCES=<google-oauth-client-id>
#
# Required scopes. Google DOES emit a `scope` claim, so leave as shown (not empty).
# OIDC_SCOPES=openid email
#
# Per-user budget ACL — maps Google email claim to budget sync IDs.
# Use `["*"]` to grant all budgets; list specific IDs to scope access.
# AUTH_BUDGET_ACL={"you@gmail.com":["<budget-sync-id>"],"spouse@gmail.com":["<budget-sync-id>"]}
