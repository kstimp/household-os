# Secrets for the Hub backend (infra/hub). Copy to hub.env (gitignored) on the VPS and
# fill in. See docs/runbook-hub-updates.md.
#
#   cp hub.env.example hub.env   # then edit hub.env

# --- Finance worker (reads Actual via the actual-http-api sidecar) -----------
# Same value as API_KEY in actual-http-api.env.
ACTUAL_API_KEY=

# Budget Sync ID (Actual → Settings → Show advanced settings → Sync ID).
ACTUAL_BUDGET_SYNC_ID=

# ONLY if you enabled Actual end-to-end encryption. Leave blank otherwise.
ACTUAL_BUDGET_ENCRYPTION_PASSWORD=
