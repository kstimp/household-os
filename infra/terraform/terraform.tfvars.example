# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

hcloud_token         = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
cloudflare_api_token = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
cloudflare_account_id = "0123456789abcdef0123456789abcdef"
cloudflare_zone_id    = "0123456789abcdef0123456789abcdef"

domain               = "example.com"
budget_subdomain     = "budget"
mcp_subdomain        = "mcp-budget"   # AI-facing MCP server host (ADR-0002); NOT behind Access
actual_api_subdomain = "actual-api"   # Actual HTTP REST API sidecar; NOT behind Access

family_emails = [
  "you@gmail.com",
  "partner@gmail.com",
]

admin_ssh_public_key = "ssh-ed25519 AAAA... you@laptop"
admin_ip_cidr        = "203.0.113.4/32"

# Admin SSH hardening (docs/install-tailscale.md). OFF by default = public tcp/22 open from
# admin_ip_cidr, the original behavior. Set true to CLOSE public SSH and reach the box only
# over the Tailscale tailnet. Flip to true ONLY after you've installed Tailscale and confirmed
# you can SSH in over the 100.x address — otherwise you lock out the public SSH path.
# ssh_over_tailscale_only = false

# Optional overrides (defaults: US East / cpx21):
# server_type    = "cpx21"   # US locations need cpx*; cx22 is EU-only
# location       = "ash"     # ash = US East, hil = US West, nbg1/fsn1/hel1 = EU
# volume_size_gb = 20
# access_session_duration = "730h"  # Access re-login interval; 1 month default, "24h" for daily

# ADR-0003 interim service-token layer on the MCP host. OFF by default. Setting
# this true adds a Cloudflare Access app that accepts a SERVICE TOKEN (non-identity)
# in front of the MCP gate — a deliberate, narrow reversal of ADR-0002. Enable only
# after confirming your MCP client can send CF-Access-Client-Id/Secret headers.
# enable_mcp_access_service_token = false

# ADR-0005 (the decision): Cloudflare Access SaaS-OIDC app as the MCP server's OIDC
# issuer. OFF by default. Turn on at cutover (docs/mcp-budget-server.md §7): it creates
# a SaaS (OIDC) app + a family-allowlist policy, and emits mcp_saas_oidc_client_id /
# _client_secret for mcp.env + the AI-client connectors. The family gate lives in the
# CF policy (family_emails), so it is NOT duplicated into AUTH_BUDGET_ACL.
# enable_mcp_saas_oidc = true
# cloudflare_team_domain = "myteam.cloudflareaccess.com"   # prints the exact OIDC issuer
# mcp_oauth_redirect_uris = [
#   "https://claude.ai/api/mcp/auth_callback",   # extend per each AI client's connector docs
# ]
# mcp_oidc_access_token_lifetime  = "30m"    # keep SHORT (write-capable finance endpoint)
# mcp_oidc_refresh_token_lifetime = "720h"   # durable refresh = "stop re-auth prompts"
