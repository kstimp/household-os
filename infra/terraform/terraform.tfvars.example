# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

hcloud_token         = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
cloudflare_api_token = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
cloudflare_account_id = "0123456789abcdef0123456789abcdef"
cloudflare_zone_id    = "0123456789abcdef0123456789abcdef"

domain           = "example.com"
budget_subdomain = "budget"
mcp_subdomain    = "mcp-budget"  # AI-facing MCP server host (ADR-0002); NOT behind Access

family_emails = [
  "you@gmail.com",
  "partner@gmail.com",
]

admin_ssh_public_key = "ssh-ed25519 AAAA... you@laptop"
admin_ip_cidr        = "203.0.113.4/32"

# Optional overrides (defaults: US East / cpx21):
# server_type    = "cpx21"   # US locations need cpx*; cx22 is EU-only
# location       = "ash"     # ash = US East, hil = US West, nbg1/fsn1/hel1 = EU
# volume_size_gb = 20
# access_session_duration = "730h"  # Access re-login interval; 1 month default, "24h" for daily
