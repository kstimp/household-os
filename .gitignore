# ── Secrets & credentials (defense-in-depth; infra/terraform has its own too) ──
# Filled-in Terraform variables — tokens, keys, emails.
terraform.tfvars
*.auto.tfvars
# Terraform state can contain secrets — never commit it.
*.tfstate
*.tfstate.*
.terraform/
# Rendered cert/key material (Cloudflare Origin cert, SSH keys, etc.).
certs/
*.pem
*.key
# Environment files.
.env
.env.*
!.env.example
# Filled-in MCP server secrets (Actual password, E2E key, Bearer token).
mcp.env
!mcp.env.example
# Filled-in Actual HTTP API secrets (Actual password, E2E key, API key).
actual-http-api.env
!actual-http-api.env.example
# Filled-in Hub backend secrets (actual-http-api key, sync ID).
hub.env
!hub.env.example

# ── Python (Hub backend) ──
__pycache__/
*.pyc
.pytest_cache/
.venv/
*.db
*.db-wal
*.db-shm

# ── Node (college app) ──
node_modules/
npm-debug.log*
yarn-error.log*
dist/
build/

# ── OS / editor junk ──
.DS_Store
Thumbs.db
.idea/
*.swp
